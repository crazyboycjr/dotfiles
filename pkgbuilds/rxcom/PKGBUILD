# rxcom from ~/Developing/rxcom: an X11 compositor in Rust with full-desktop
# zoom driven by the _PICOM_ZOOM root window property, as in picom-zoom. The X
# server composes with XRender; Vulkan presents where DRI3 can share the scene.

pkgname=rxcom
pkgver=0.2.0.r0
pkgrel=1
pkgdesc='X11 compositor with full-desktop zoom, presenting with Vulkan'
arch=(x86_64)
license=(MIT)
depends=(gcc-libs glibc libxcb vulkan-icd-loader)
makedepends=(cargo git shaderc)
source=("$pkgname::git+file://$HOME/Developing/rxcom#branch=main")
b2sums=('SKIP')

pkgver() {
  cd $pkgname
  printf '0.2.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd $pkgname
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd $pkgname
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd $pkgname
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen --lib
}

package() {
  cd $pkgname
  install -Dm755 target/release/rxcom -t "$pkgdir/usr/bin/"
  install -Dm644 README.md DESIGN.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
